---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ViberIcon from '../components/ViberIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site } from '../utils/products';

const serviceBrands = [
  { name: 'Saeco', slug: 'saeco', desc: 'Ремонт и профилактика на всички автоматични модели Saeco.', accent: '#e63946' },
  { name: 'DeLonghi', slug: 'delonghi', desc: 'Ремонт и профилактика на всички автоматични модели DeLonghi.', accent: '#284d47' },
  { name: 'Jura', slug: 'jura', desc: 'Ремонт и профилактика на всички автоматични модели Jura.', accent: '#1a1a1a' },
  { name: 'Philips', slug: 'philips', desc: 'Ремонт и профилактика на всички автоматични модели Philips.', accent: '#0050a0' },
];

const steps = [
  { num: '1', title: 'Обадете се', desc: 'Свържете се с нас по телефон или Viber. Ще ви дадем първоначална консултация.' },
  { num: '2', title: 'Изпратете или донесете', desc: `Донесете лично на ${site.address.street}, ${site.address.district}, ${site.address.city} или изпратете с куриер.` },
  { num: '3', title: 'Диагностика и ремонт', desc: 'Установяваме проблема, отстраняваме го с нови части и правим пълна профилактика.' },
  { num: '4', title: 'Вземете я обратно', desc: 'Обаждаме ви се, когато машината е готова. Идвате лично или я изпращаме с куриер.' },
];

// §2a hub layer — real symptoms walk-in customers describe. `href` is wired to the matching
// article ONLY when that article is live (no dead links); until then the card renders as prose.
// See seo/content/service-hub-blueprint.md §2a + §3.
const problems = [
  {
    title: 'Не загрява или прави хладко кафе',
    desc: 'Обикновено причината е в нагревателя, термостата или предпазителя. При диагностиката установяваме точно коя е и дали се налага смяна на част.',
    href: null, // → /blog/zashto-kafemashinata-ne-zagryava (W2)
    anchor: 'защо кафемашината не загрява',
  },
  {
    title: 'Лошо качество на кафето',
    desc: 'Често идва от износени уплътнения или разстроена мелачка. Проверяваме уплътненията и настройката на мелачката и коригираме каквото не е наред.',
    href: null,
    anchor: 'слаб натиск при еспресо',
  },
  {
    title: 'Спряла или блокирала мелачка',
    desc: 'Ако мелачката е блокирала и тропа, най-вероятно е попаднало чуждо тяло, например камъче в зърната. Ако изобщо не работи, може да е изгорял мотор или друга повреда. Проверяваме и ви казваме какво е.',
    href: null,
    anchor: 'проблем с мелачката',
  },
  {
    title: 'Тече или прокапва вода',
    desc: 'Теч под машината най-често идва от спукано уплътнение или маркуч.',
    href: null,
    anchor: 'кафемашината тече вода',
  },
  {
    title: 'Показва грешка или код',
    desc: 'Кодовете за грешка при DeLonghi, Saeco и другите марки показват кой модул има проблем. Разчитаме кода, намираме причината и я отстраняваме.',
    href: '/blog/delonghi-serviz-chesti-problemi', // brand repair guide (W7); a dedicated
    // error-code article (W11) can take this slot later — anchor names the real destination.
    anchor: 'чести проблеми при кафемашини DeLonghi',
  },
  {
    title: 'Блокира и спира да пуска вода',
    desc: 'Най-често причината е натрупан котлен камък, който е запушил изхода на бойлера и тесните канали — обикновено след години твърда вода без декалциране. Правим отпушване и пълна профилактика.',
    href: '/blog/kak-se-dekalcira-saeco',
    anchor: 'как се декалцира Саеко',
  },
  {
    title: 'Струва ли си изобщо ремонтът?',
    desc: 'Не всяка повреда си заслужава ремонта. Казваме ви честно кога ремонтът е изгоден и кога е по-разумно да смените машината. Диагностиката е безплатна и не ви задължава с нищо.',
    href: null, // → /blog/remont-ili-zamyana-kafemashina (W5)
    anchor: 'ремонт или замяна',
  },
];

const faqs = [
  {
    q: 'Колко струва ремонтът на кафемашина?',
    a: 'Диагностиката е безплатна. След като установим повредата, ви казваме точната цена предварително — започваме работа само след вашето съгласие. Ако решите да не ремонтирате, не дължите нищо.',
  },
  {
    q: 'За колко време ще бъде готова машината?',
    a: 'В повечето случаи ремонтът е готов до 10 работни дни. Ако се налага да поръчаме специфична част, ще ви уведомим предварително.',
  },
  {
    q: 'С какви части работите?',
    a: 'Само с нови части. Не използваме части втора употреба — затова даваме гаранция на извършения ремонт.',
  },
  {
    q: 'Кои марки кафемашини обслужвате?',
    a: 'Ремонтираме и профилактираме всички автоматични модели на Saeco, DeLonghi, Jura и Philips.',
  },
  {
    q: 'Има ли гаранция на ремонта?',
    a: 'Да. На всеки извършен ремонт даваме гаранция, а пълната профилактика е включена във всеки ремонт.',
  },
  {
    q: 'Трябва ли да донеса машината лично?',
    a: `Можете да я донесете лично в сервиза на ${site.address.street}, ${site.address.detail} в ${site.address.city} или да я изпратите с куриер от цялата страна. След ремонта я връщаме по същия начин.`,
  },
  {
    q: 'Какво включва пълната профилактика?',
    a: 'Проверка и смяна на уплътнения, декалциране и цялостно почистване, проверка на мелачката, както и почистване и смазване на движещите се части — кафе група и редуктор. Включена е във всеки ремонт или може да се направи самостоятелно.',
  },
  {
    q: 'Защо машината ми прави лошо кафе?',
    a: 'Може да са няколко причини. Често помага добра настройка на мелачката, както и почистване и смазване на кафе групата. А понякога причината е просто некачествено кафе на зърна.',
  },
];
---

<BaseLayout
  title="Сервиз за кафемашини София — 18+ години опит | Swiss Coffe"
  description="Професионален сервиз за автоматични кафемашини Saeco, DeLonghi, Jura и Philips в София. Ремонт и пълна профилактика само с нови части. Обадете се: 0894 807 755"
  bodyClass="!bg-cream"
>

  <!-- Section 1: Hero -->
  <section class="bg-primary pt-6 pb-10 sm:pb-14 gsap-section">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <Breadcrumbs items={[{ label: 'Начало', href: '/' }, { label: 'Сервиз на кафемашини' }]} dark={false} />

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 sm:gap-10 items-center mt-4">
        <!-- Left: headline + subtitle -->
        <div class="lg:col-span-3 lg:pr-8 gsap-fade-up">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4 sm:mb-6 text-white">Сервиз на кафемашини</h1>
          <p class="text-sm sm:text-base lg:text-lg text-white/70 leading-relaxed">
            Над 18 години ремонтираме и обслужваме автоматични кафемашини в София.
          </p>
        </div>

        <!-- Right: CTA card -->
        <div class="lg:col-span-2 gsap-fade-up" style="--delay: 0.1s">
          <div class="bg-white/10 border border-white/15 rounded-2xl p-5 sm:p-6 text-white backdrop-blur-sm">
            <p class="text-white/60 text-sm font-medium uppercase tracking-wide mb-3">Свържете се с нас</p>
            <a href={`tel:${site.phone}`} class="inline-flex items-center gap-3 bg-btn hover:bg-btn-hover text-white font-bold text-lg sm:text-xl px-4 py-2.5 rounded-xl mb-4 transition-colors w-full justify-center sm:justify-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
              </svg>
              {site.phoneDisplay}
            </a>
            <div class="space-y-2 text-sm text-white/70">
              <div class="flex items-center gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-btn" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{site.hours}</span>
              </div>
              <div class="flex items-start gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-btn mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{site.address.street}, {site.address.detail}, {site.address.district}, {site.address.city}</span>
              </div>
              <div class="flex items-center gap-2.5">
                <ViberIcon class="h-4 w-4 flex-shrink-0 text-btn" />
                <a href={site.viber} class="hover:text-white transition-colors">Пишете ни във Viber</a>
              </div>
              <div class="flex items-center gap-2.5">
                <WhatsAppIcon class="h-4 w-4 flex-shrink-0 text-btn" />
                <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Пишете ни в WhatsApp</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: What We Do -->
  <section class="bg-cream py-10 sm:py-16 gsap-section">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-8 sm:mb-12 gsap-fade-up">Какво правим</h2>

      <div class="space-y-6 max-w-3xl mx-auto">

        <!-- Card 1: Диагностика и ремонт (PRIMARY) -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm flex flex-col gsap-fade-up" style="--delay: 0.08s">
          <div class="bg-primary px-5 sm:px-6 py-4 sm:py-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
              </svg>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-white">Диагностика и ремонт</h3>
          </div>
          <div class="px-5 sm:px-6 py-4 sm:py-5 flex flex-col flex-1">
            <div class="flex items-start gap-2.5 bg-primary/8 border border-primary/15 rounded-xl px-4 py-3 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-sm font-medium text-primary">
                Безплатна диагностика — ако откажете ремонта, не дължите нищо.
              </p>
            </div>
            <p class="text-sm sm:text-base text-text/70 leading-relaxed mb-4">
              Установяваме всички дефекти и ги отстраняваме.
            </p>
            <ul class="space-y-2.5 flex-1">
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Готово до 10 работни дни
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Само нови части
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Гаранция на извършения ремонт
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Пълно обслужване — винаги включено
              </li>
            </ul>
          </div>
        </div>

        <!-- Card 2: Пълно обслужване (SECONDARY) -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm flex flex-col gsap-fade-up" style="--delay: 0.14s">
          <div class="bg-primary px-5 sm:px-6 py-4 sm:py-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-white">Пълно обслужване</h3>
          </div>
          <div class="px-5 sm:px-6 py-4 sm:py-5 flex flex-col flex-1">
            <p class="text-sm sm:text-base text-text/70 leading-relaxed mb-4">
              Включено във всеки ремонт или достъпно като отделна услуга.
            </p>
            <ul class="space-y-2.5 flex-1">
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Проверка и смяна на уплътнения
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Декалциране и цялостно почистване
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Проверка ножове и четки, почистване и настройка
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-sm text-text/80">
                <svg class="h-3.5 w-3.5 text-btn flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Почистване и смазване на движещи се части — редукция, кафе група
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 3: Проблеми, които решаваме (hub topical layer — blueprint §2a) -->
  <section class="bg-cream pb-10 sm:pb-16 gsap-section">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-3 gsap-fade-up">Проблеми, които решаваме</h2>
      <p class="text-center text-sm sm:text-base text-text/60 max-w-2xl mx-auto mb-8 sm:mb-12 gsap-fade-up">
        Ето най-честите повреди при автоматичните кафемашини, с които идват клиентите ни, и какво стои зад тях.
      </p>
      <div class="max-w-3xl mx-auto space-y-3">
        {problems.map((problem, i) => (
          <details class="group bg-white rounded-xl border border-border px-5 py-4 gsap-fade-up" style={`--delay: ${i * 0.06}s`}>
            <summary class="font-bold text-primary cursor-pointer list-none flex items-center justify-between gap-3">
              {problem.title}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="text-sm sm:text-base text-text/70 leading-relaxed mt-3">{problem.desc}</p>
            {problem.href && (
              <a href={problem.href} class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full bg-primary text-white text-sm font-semibold hover:bg-btn transition-colors">
                Прочетете: {problem.anchor} →
              </a>
            )}
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Process Steps -->
  <section class="bg-primary py-10 sm:py-16 gsap-section">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center mb-8 sm:mb-12 gsap-fade-up text-white">Как протича ремонтът</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-4">
        {steps.map((step, i) => (
          <div class="flex flex-col items-center text-center relative gsap-fade-up" style={`--delay: ${i * 0.08}s`}>
            {i < steps.length - 1 && (
              <div class="hidden md:block absolute top-6 left-[calc(50%+28px)] right-[calc(-50%+28px)] border-t-2 border-dashed border-white/30"></div>
            )}
