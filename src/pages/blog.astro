---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPublishedPosts } from '../utils/blog';

const posts = await getPublishedPosts();

// Keep the index noindexed until at least one real post exists (avoids a thin
// empty page in the index). Auto-flips the moment a post is published.
const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Блог за кафемашини — съвети за ремонт, поддръжка и купуване | Кафемашини"
  description="Практични съвети за ремонт, декалциране, поддръжка и избор на кафемашина втора употреба — от сервиз с над 18 години опит в София."
  noindex={!hasPosts}
  bodyClass="!bg-cream"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={[{ label: 'Начало', href: '/' }, { label: 'Блог' }]} />
    <h1 class="text-3xl md:text-4xl font-bold mb-8">Блог</h1>

    {hasPosts ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    ) : (
      <p class="text-text/60">Скоро...</p>
    )}
  </div>
</BaseLayout>
